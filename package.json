{
  "name": "project-vogel",
  "description": "Web Book - Application, based on the kinderbücher series 'Vögel' in Germany",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://lone-do.github.io/project-vogel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lone-DO/project-vogel.git"
  },
  "bugs": {
    "url": "https://github.com/Lone-DO/project-vogel/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "lone-do",
  "scripts": {
    "dev": "vite --port 3003 --strictPort",
    "build": "run-p type-check \"build-only {@}\"",
    "build:plugin": "vite build --mode plugin",
    "build:dev": "vite build --mode development --watch",
    "preview": "vite preview --port 3003 --strictPort --mode development",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sass": "^1.101.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.7"
  }
}
